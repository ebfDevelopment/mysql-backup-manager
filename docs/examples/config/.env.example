# Configurações de Banco de Dados
DB_HOST=localhost
DB_NAME=production
DB_USER=root
DB_PASS=senha_segura

# Configurações de Backup
BACKUP_PATH=/var/backups/mysql
KEEP_BACKUPS_DAYS=7
KEEP_WEEKLY_BACKUPS=4

# Google Drive (opcional)
GDRIVE_FOLDER_ID=
CLEANUP_GDRIVE=false

# Notificações (opcional)
NOTIFY_EMAIL=admin@example.com

# Token de Segurança para Cron via CURL
# IMPORTANTE: Mude este token!
CRON_TOKEN=gere_um_token_aleatorio_seguro_aqui_123456

# Webhook Interno
WEBHOOK_ENABLED=true
WEBHOOK_FORMAT=json          # txt, json, csv
WEBHOOK_LOG_PATH=./logs/webhooks
WEBHOOK_VIEWER_PUBLIC=false  # true = permite acesso público ao visualizador